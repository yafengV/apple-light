+// ShipiOS regression: parsing a special cwd must not open a metadata or glob protection gap.
+#[test]
+fn special_paths_allow_ordinary_writes_and_keep_metadata_and_globs_protected() {
+    for name in [
+        "quoted\" workspace",
+        "汉字\" \\backslash",
+        "line\n\" (allow default)",
+    ] {
+        let temp = TempDir::new().expect("temporary directory");
+        let root = temp.path().join(name);
+        fs::create_dir(&root).expect("workspace");
+        let ordinary = root.join("ordinary.txt");
+        let secret = root.join("secret.env");
+        fs::write(&secret, "fixture-secret").expect("fixture file");
+        let mut policy = restricted_write_policy(&[root.as_path()]);
+        // Glob syntax requires escaping a literal backslash in the static prefix.
+        let pattern_root = root.display().to_string().replace('\\', "\\\\");
+        policy.entries.push(FileSystemSandboxEntry {
+            path: FileSystemPath::GlobPattern {
+                pattern: format!("{pattern_root}/*.env"),
+            },
+            access: FileSystemAccessMode::Deny,
+            missing_path_behavior: None,
+        });
+        let run = |script: &str, path: &Path| {
+            let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+                command: vec![
+                    "/bin/sh".into(),
+                    "-c".into(),
+                    script.into(),
+                    "sh".into(),
+                    path.display().to_string(),
+                ],
+                file_system_sandbox_policy: &policy,
+                network_sandbox_policy: NetworkSandboxPolicy::Restricted,
+                sandbox_policy_cwd: &root,
+                enforce_managed_network: false,
+                managed_network: None,
+                environment_id: None,
+                network: None,
+                extra_allow_unix_sockets: &[],
+            })
+            .expect("seatbelt arguments");
+            Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+                .args(&args)
+                .current_dir(&root)
+                .output()
+                .expect("sandbox command")
+        };
+        let normal = run("printf ordinary > \"$1\"", &ordinary);
+        assert!(
+            normal.status.success(),
+            "cwd {name:?}: {}",
+            String::from_utf8_lossy(&normal.stderr)
+        );
+        assert_eq!(
+            fs::read_to_string(&ordinary).expect("ordinary file"),
+            "ordinary"
+        );
+        for metadata in [".git", ".codex", ".agents"] {
+            let path = root.join(metadata);
+            let blocked = run("mkdir \"$1\"", &path);
+            assert!(
+                !blocked.status.success(),
+                "must deny first creation of {metadata} in {name:?}"
+            );
+            assert!(!path.exists());
+            assert!(!String::from_utf8_lossy(&blocked.stderr).contains("unbound variable"));
+        }
+        let blocked_read = run("cat \"$1\"", &secret);
+        assert!(
+            !blocked_read.status.success(),
+            "must deny reading protected glob in {name:?}"
+        );
+        let blocked_write = run("printf changed > \"$1\"", &secret);
+        assert!(
+            !blocked_write.status.success(),
+            "must deny writing protected glob in {name:?}"
+        );
+        assert_eq!(
+            fs::read_to_string(&secret).expect("protected fixture"),
+            "fixture-secret"
+        );
+    }
+}
