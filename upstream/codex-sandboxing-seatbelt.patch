+// Modified by ShipiOS: SBPL regex literals do not escape embedded double quotes.
+// Pass exceptional patterns as argv parameters so they cannot terminate the policy literal.
+fn seatbelt_regex_filter(regex: &str, prefix: &str, params: &mut Vec<(String, PathBuf)>) -> String {
+    if regex.contains(['"', '\n', '\r']) {
+        let name = format!("{prefix}_REGEX_{}", params.len());
+        params.push((name.clone(), PathBuf::from(regex)));
+        format!("(regex (param \"{name}\"))")
+    } else {
+        format!(r#"(regex #"{regex}")"#)
+    }
+}
