+/// Non-cloneable reply capability for one original Core approval future.
+/// Dropping it cancels that request; it never falls back to call-ID routing.
+pub struct CapturedApproval {
+    reply: Arc<std::sync::Mutex<Option<oneshot::Sender<codex_protocol::protocol::ReviewDecision>>>>,
+    session: Arc<Session>,
+    turn_id: String,
+}
+
+impl Drop for CapturedApproval {
+    fn drop(&mut self) {
+        self.reply.lock().expect("approval reply lock").take();
+    }
+}
+
+impl CapturedApproval {
+    pub fn is_closed(&self) -> bool {
+        self.reply
+            .lock()
+            .expect("approval reply lock")
+            .as_ref()
+            .is_none_or(|sender| sender.is_closed())
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "cancelled turns must not persist a later policy amendment"
+    )]
+    pub async fn resolve(
+        self,
+        decision: codex_protocol::protocol::ReviewDecision,
+    ) -> anyhow::Result<bool> {
+        let active = self.session.active_turn.lock().await;
+        if self.is_closed()
+            || !active
+                .as_ref()
+                .and_then(|turn| turn.task.as_ref())
+                .is_some_and(|task| task.turn_context.sub_id == self.turn_id)
+        {
+            return Ok(false);
+        }
+        if matches!(decision, codex_protocol::protocol::ReviewDecision::Abort) {
+            drop(active);
+            return Ok(self
+                .session
+                .abort_turn_if_active(
+                    &self.turn_id,
+                    codex_protocol::protocol::TurnAbortReason::Interrupted,
+                )
+                .await);
+        }
+        if let codex_protocol::protocol::ReviewDecision::ApprovedExecpolicyAmendment {
+            proposed_execpolicy_amendment,
+        } = &decision
+        {
+            if let Err(error) = self
+                .session
+                .persist_execpolicy_amendment(proposed_execpolicy_amendment)
+                .await
+            {
+                let message = format!("Failed to apply execpolicy amendment: {error}");
+                tracing::warn!("{message}");
+                self.session
+                    .send_event_raw(codex_protocol::protocol::Event {
+                        id: self.turn_id.clone(),
+                        msg: codex_protocol::protocol::EventMsg::Warning(
+                            codex_protocol::protocol::WarningEvent { message },
+                        ),
+                    })
+                    .await;
+            }
+        }
+        Ok(self
+            .reply
+            .lock()
+            .expect("approval reply lock")
+            .take()
+            .is_some_and(|sender| sender.send(decision).is_ok()))
+    }
+}
