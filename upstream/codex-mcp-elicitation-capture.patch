+
+/// One original runtime callback, even if an MCP connection reuses its request ID.
+pub struct CapturedMcpElicitation {
+    reply: Arc<StdMutex<Option<oneshot::Sender<ElicitationResponse>>>>,
+}
+impl Drop for CapturedMcpElicitation {
+    fn drop(&mut self) {
+        self.reply.lock().expect("MCP reply lock").take();
+    }
+}
+impl CapturedMcpElicitation {
+    pub fn is_closed(&self) -> bool {
+        self.reply
+            .lock()
+            .expect("MCP reply lock")
+            .as_ref()
+            .is_none_or(|sender| sender.is_closed())
+    }
+    pub fn resolve(self, response: ElicitationResponse) -> bool {
+        self.reply
+            .lock()
+            .expect("MCP reply lock")
+            .take()
+            .is_some_and(|sender| sender.send(response).is_ok())
+    }
+}
